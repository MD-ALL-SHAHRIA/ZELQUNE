# Admin dashboard env. Copy to .env.local for `pnpm dev` (port 3200).

# Gateway base URL as the browser sees it. The gateway must list this site's origin in
# CORS_ORIGINS (infra/.env: http://localhost:3200 in dev).
NEXT_PUBLIC_API_URL=http://localhost:3000
# The storefront, for "view on site" links.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
