# Production settings for infra/docker-compose.prod.yml. Copy to infra/.env.production on the
# server (never commit it) and fill every empty value. Generate secrets with:
#   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
# JWT keys and CUSTOMER_KEY_SECRET / INTERNAL_RPC_SECRET: `node infra/scripts/dev-keys.mjs --print`
# style values work, but generate fresh ones for production — never reuse your dev keys.

# Image tag for this release (e.g. the git commit). Roll back by setting the previous one.
RELEASE=latest

DOMAIN=zelqune.com
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=support@zelqune.com

# Database (superuser + one password shared by the per-service roles).
POSTGRES_USER=zelqune
POSTGRES_PASSWORD=
POSTGRES_DB=zelqune
SERVICE_DB_PASSWORD=

RABBITMQ_USER=zelqune
RABBITMQ_PASSWORD=
REDIS_PASSWORD=

# 32+ characters each.
INTERNAL_RPC_SECRET=
CUSTOMER_KEY_SECRET=
# ES256 key pair (PEM, one line with \n escapes).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Cloudflare Turnstile (free; site key is public, secret key is not).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Product photos. `r2` (Cloudflare R2, needs the owner's sign-up) or `local` (stored on this
# server in the media-data volume, backed up by infra/scripts/backup.sh).
STORAGE_DRIVER=local
MEDIA_PUBLIC_BASE_URL=https://media.zelqune.com/dev-storage
LOCAL_STORAGE_SIGNING_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Account and order emails, sent through Resend (docs/email.md). Only SMTP_PASS is yours to fill:
# your Resend API key (starts with re_). EMAIL_DRIVER=console logs emails instead of sending.
EMAIL_DRIVER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=Zelqune <support@zelqune.com>

# First owner account (created on first start, then remove OWNER_PASSWORD from this file).
OWNER_PHONE=
OWNER_PASSWORD=
OWNER_NAME=
OWNER_NOTIFY_PHONE=
# Where new-order and new-request alerts are emailed (e.g. your Gmail).
OWNER_NOTIFY_EMAIL=

PAYMENT_BKASH_NUMBER=
PAYMENT_BKASH_ACCOUNT_TYPE=personal
PAYMENT_NAGAD_NUMBER=
PAYMENT_NAGAD_ACCOUNT_TYPE=personal

NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_META_PIXEL_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
