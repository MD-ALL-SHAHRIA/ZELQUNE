# docker-compose overrides (cp infra/.env.example infra/.env). Dev-only defaults; never reuse in production.
POSTGRES_USER=zelqune
POSTGRES_PASSWORD=zelqune_dev
POSTGRES_DB=zelqune
# Password for every per-service role (identity_svc, catalog_svc, ...). Applied on first volume init.
SERVICE_DB_PASSWORD=zelqune_svc_dev
RABBITMQ_USER=zelqune
RABBITMQ_PASSWORD=zelqune_dev
LOG_LEVEL=info
# Browser origins allowed to call the gateway (storefront, dashboard dev servers).
CORS_ORIGINS=http://localhost:3100,http://localhost:3200
