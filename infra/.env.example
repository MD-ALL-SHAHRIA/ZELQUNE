# docker-compose overrides (cp infra/.env.example infra/.env). Dev-only defaults; never reuse in production.
POSTGRES_USER=zelqune
POSTGRES_PASSWORD=zelqune_dev
POSTGRES_DB=zelqune
# Password for every per-service role (identity_svc, catalog_svc, ...). Applied on first volume init.
SERVICE_DB_PASSWORD=zelqune_svc_dev
RABBITMQ_USER=zelqune
RABBITMQ_PASSWORD=zelqune_dev
LOG_LEVEL=info
# Browser origins allowed to call the gateway (storefront, dashboard dev servers).
CORS_ORIGINS=http://localhost:3100,http://localhost:3200
# --- Auth (generate local keys: pnpm keys:dev; never commit real values) ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# OWNER admin created by `pnpm seed` (phone 01XXXXXXXXX, password >= 12 chars). No defaults.
OWNER_PHONE=
OWNER_PASSWORD=
OWNER_NAME=
# --- Media (dev uses the local storage fake on catalog-service) ---
LOCAL_STORAGE_SIGNING_SECRET=
# --- Checkout ---
# bKash/Nagad numbers customers pay to (empty = method not offered; pre-orders need one)
PAYMENT_BKASH_NUMBER=
PAYMENT_BKASH_ACCOUNT_TYPE=personal
PAYMENT_NAGAD_NUMBER=
PAYMENT_NAGAD_ACCOUNT_TYPE=personal
# Pre-order / made-to-order advance (paisa) and how long unpaid orders are kept
ADVANCE_FIXED_PAISA=30000
ORDER_HOLD_HOURS=48
# HMAC key for the pseudonymous customer id sent to analytics (pnpm keys:dev)
CUSTOMER_KEY_SECRET=
# Owner's phone for new bulk-order (RFQ) SMS alerts; console SMS in dev
OWNER_NOTIFY_PHONE=

# Seconds public catalog/content GETs are cached in Redis by the gateway (0 = off).
# PUBLIC_CACHE_SECONDS=30

# --- Customer accounts and email (ADR 0021) ---
# Dev sends every email to Mailpit (http://localhost:8025). Production: your provider's SMTP.
EMAIL_DRIVER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Zelqune <hello@zelqune.com>
# Public URLs used in links and OAuth redirects.
PUBLIC_API_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3100
# Google / Facebook sign-in stay hidden until these are set (docs/accounts-setup.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
