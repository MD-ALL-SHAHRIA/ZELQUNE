{
  "name": "@zelqune/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Zelqune storefront (Next.js App Router, English default + Bangla)",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots",
    "copy:check": "node scripts/copy-check.mjs",
    "gen:store": "rtk-query-codegen-openapi openapi-codegen.cjs && prettier --write src/store/api/generated.ts --log-level warn"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@reduxjs/toolkit": "2.13.0",
    "@zelqune/api-client": "workspace:*",
    "@zelqune/ui-tokens": "workspace:*",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rtk-query/codegen-openapi": "2.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
