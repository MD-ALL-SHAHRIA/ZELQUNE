# Storefront env. Copy to .env.local for `pnpm dev`.

# Gateway base URL as the browser sees it (CORS: the gateway must allow this site's origin).
NEXT_PUBLIC_API_URL=http://localhost:3000
# Gateway URL for server-side rendering (defaults to NEXT_PUBLIC_API_URL).
API_URL=
# Public site URL (canonical links, sitemap, OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Where product photos are served from (next/image allow-list).
MEDIA_BASE_URL=http://localhost:3002/dev-storage

# Cloudflare Turnstile site key. Empty in dev: no widget, a dev token is sent and the gateway's
# fake verifier accepts it. `next build` fails without it unless ALLOW_TEST_TURNSTILE=true
# (CI and local e2e builds only; never set it in production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ALLOW_TEST_TURNSTILE=

# Meta Pixel. Empty = Pixel off (no script loaded).
NEXT_PUBLIC_META_PIXEL_ID=

# Business WhatsApp number, international digits only (e.g. 8801711000000). Empty = the
# "Chat on WhatsApp" buttons are hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
