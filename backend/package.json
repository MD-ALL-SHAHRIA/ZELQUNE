{
  "name": "@zelqune/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Zelqune e-commerce backend: NestJS microservices monorepo",
  "scripts": {
    "postinstall": "sh scripts/prisma-generate.sh",
    "prisma:generate": "sh scripts/prisma-generate.sh",
    "build": "sh scripts/build-all.sh",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "openapi:export": "ts-node -r tsconfig-paths/register --transpile-only scripts/export-openapi.ts ../packages/api-client/openapi.json",
    "test:integration": "jest -c jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/microservices": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "@nestjs/terminus": "^11",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "amqp-connection-manager": "^4.1.15",
    "amqplib": "^0.10.9",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "ioredis": "^5.11.1",
    "jose": "^5",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "5.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^12",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^29",
    "supertest": "^7.3.1",
    "ts-jest": "^29",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
