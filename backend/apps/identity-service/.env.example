# identity-service: for running outside Docker (cp .env.example .env). docker-compose sets these itself.
NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3001
TCP_HOST=0.0.0.0
TCP_PORT=4001
DB_SCHEMA=identity
DATABASE_URL=postgresql://identity_svc:zelqune_svc_dev@localhost:5432/zelqune?schema=identity
RABBITMQ_URL=amqp://zelqune:zelqune_dev@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
# ES256 private key (PKCS#8 PEM; "\n" escapes allowed). Generate dev keys: pnpm keys:dev (repo root)
JWT_PRIVATE_KEY=
JWT_ISSUER=zelqune-identity
JWT_AUDIENCE=zelqune-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Seed only (pnpm seed): the OWNER admin. No defaults on purpose.
OWNER_PHONE=
OWNER_PASSWORD=
OWNER_NAME=
