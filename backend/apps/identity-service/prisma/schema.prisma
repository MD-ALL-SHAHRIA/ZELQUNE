// identity-service owns the "identity" Postgres schema. Never reference another service's tables;
// share data only via RPC or events (libs/contracts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Transactional outbox: written in the same transaction as the business change,
/// published to RabbitMQ by OutboxRelay (libs/common/src/outbox).
model OutboxEvent {
  id            String    @id @db.Uuid
  type          String
  version       Int
  source        String
  payload       Json
  requestId     String?   @map("request_id")
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

/// Idempotent-consumer ledger: one row per (event, handler) already applied.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, handler])
  @@map("processed_events")
}

enum Role {
  CUSTOMER
  STAFF
  OWNER
}

/// A person known to Zelqune. Phone (E.164, +8801XXXXXXXXX) is the identity.
/// Only STAFF/OWNER have a password; customers sign in with OTP from M2.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  phone        String    @unique
  name         String?
  email        String?   @unique
  role         Role      @default(CUSTOMER)
  passwordHash String?   @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  @@map("users")
}

/// Opaque rotating refresh tokens; only the SHA-256 hash is stored. All tokens of one login
/// share a familyId so that reuse of a rotated token revokes the whole session.
model RefreshToken {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason")
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  userAgent     String?   @map("user_agent")
  ip            String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}
