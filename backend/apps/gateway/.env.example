# gateway: for running outside Docker (cp .env.example .env). docker-compose sets these itself.
NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3000
REDIS_URL=redis://localhost:6379
# Comma-separated browser origins allowed to call the API (storefront, dashboard).
CORS_ORIGINS=http://localhost:3100,http://localhost:3200
RPC_TIMEOUT_MS=5000
IDENTITY_SERVICE_HOST=localhost
IDENTITY_SERVICE_PORT=4001
CATALOG_SERVICE_HOST=localhost
CATALOG_SERVICE_PORT=4002
INVENTORY_SERVICE_HOST=localhost
INVENTORY_SERVICE_PORT=4003
ORDER_SERVICE_HOST=localhost
ORDER_SERVICE_PORT=4004
PAYMENT_SERVICE_HOST=localhost
PAYMENT_SERVICE_PORT=4005
SHIPPING_SERVICE_HOST=localhost
SHIPPING_SERVICE_PORT=4006
NOTIFICATION_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_PORT=4007
ANALYTICS_SERVICE_HOST=localhost
ANALYTICS_SERVICE_PORT=4008
# Express "trust proxy": false locally; behind the VPS reverse proxy use 1 (hop count) or the proxy subnet.
TRUST_PROXY=false
# ES256 public key (SPKI PEM; "\n" escapes allowed) matching identity-service JWT_PRIVATE_KEY. pnpm keys:dev
JWT_PUBLIC_KEY=
JWT_ISSUER=zelqune-identity
JWT_AUDIENCE=zelqune-api
# Refresh cookie: HttpOnly; Secure; SameSite=Strict; Path=/v1/admin/auth (ADR 0006)
REFRESH_COOKIE_NAME=zq_rt
COOKIE_SECURE=true
# Production: ".<domain>" so admin.<domain> and api.<domain> share the cookie. Empty = host-only.
COOKIE_DOMAIN=
# Rate limits (per client IP) and the per-phone failed-login lock
RATE_LIMIT_PER_MINUTE=120
LOGIN_MAX_PER_IP=5
LOGIN_IP_WINDOW_SECONDS=900
LOGIN_MAX_FAILED_PER_PHONE=5
LOGIN_LOCK_SECONDS=900
# Storefront rate limits (per client IP)
CHECKOUT_MAX_PER_IP=10
CHECKOUT_IP_WINDOW_SECONDS=600
CART_WRITES_PER_MINUTE=60
TRACK_PER_MINUTE=20
# Bot check on checkout: fake (dev/tests: any token except "fail*" passes) or cloudflare
TURNSTILE_DRIVER=fake
TURNSTILE_SECRET_KEY=
