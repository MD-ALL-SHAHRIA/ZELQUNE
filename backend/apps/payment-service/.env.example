# payment-service: for running outside Docker (cp .env.example .env). docker-compose sets these itself.
NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3005
TCP_HOST=0.0.0.0
TCP_PORT=4005
DB_SCHEMA=payments
DATABASE_URL=postgresql://payments_svc:zelqune_svc_dev@localhost:5432/zelqune?schema=payments
RABBITMQ_URL=amqp://zelqune:zelqune_dev@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
EVENT_RETRY_DELAYS_MS=5000,30000,120000
# Where customers send manual payments (shown at checkout). Empty = method not offered.
PAYMENT_BKASH_NUMBER=
PAYMENT_BKASH_ACCOUNT_TYPE=personal
PAYMENT_NAGAD_NUMBER=
PAYMENT_NAGAD_ACCOUNT_TYPE=personal
