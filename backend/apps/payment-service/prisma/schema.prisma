// payment-service owns the "payments" Postgres schema. Never reference another service's tables;
// share data only via RPC or events (libs/contracts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Transactional outbox: written in the same transaction as the business change,
/// published to RabbitMQ by OutboxRelay (libs/common/src/outbox).
model OutboxEvent {
  id            String    @id @db.Uuid
  type          String
  version       Int
  source        String
  payload       Json
  requestId     String?   @map("request_id")
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

/// Idempotent-consumer ledger: one row per (event, handler) already applied.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, handler])
  @@map("processed_events")
}

enum PaymentMethod {
  COD
  BKASH_MANUAL
  NAGAD_MANUAL
}

enum PaymentKind {
  ADVANCE
  FULL
  COD
}

enum PaymentStatus {
  SUBMITTED
  VERIFIED
  REJECTED
  COD_PENDING
  COD_CONFIRMED
  COLLECTED
  VOID
}

/// Money is integer paisa. trxId is globally unique (normalised uppercase); a VOID payment
/// moves its trxId to voidedTrxId so the customer can retry after a technical failure, while a
/// REJECTED trxId stays blocked.
model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  orderId             String        @map("order_id") @db.Uuid
  orderCode           String        @map("order_code")
  method              PaymentMethod
  kind                PaymentKind
  status              PaymentStatus
  amountPaisa         Int           @map("amount_paisa")
  trxId               String?       @unique @map("trx_id")
  voidedTrxId         String?       @map("voided_trx_id")
  payerPhone          String?       @map("payer_phone")
  amountReceivedPaisa Int?          @map("amount_received_paisa")
  verifiedBy          String?       @map("verified_by") @db.Uuid
  verifiedAt          DateTime?     @map("verified_at") @db.Timestamptz(3)
  rejectionReason     String?       @map("rejection_reason")
  voidReason          String?       @map("void_reason")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  history PaymentStatusChange[]

  @@index([orderId])
  @@map("payments")
}

model PaymentStatusChange {
  id        String         @id @default(uuid()) @db.Uuid
  paymentId String         @map("payment_id") @db.Uuid
  from      PaymentStatus?
  to        PaymentStatus
  actor     String?
  note      String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_status_changes")
}

/// Owner-editable settings (ADR 0017): one JSON value per key; env values apply until saved.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by")

  @@map("settings")
}
