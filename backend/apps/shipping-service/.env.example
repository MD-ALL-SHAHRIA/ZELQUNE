# shipping-service: for running outside Docker (cp .env.example .env). docker-compose sets these itself.
NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3006
TCP_HOST=0.0.0.0
TCP_PORT=4006
DB_SCHEMA=shipping
DATABASE_URL=postgresql://shipping_svc:zelqune_svc_dev@localhost:5432/zelqune?schema=shipping
RABBITMQ_URL=amqp://zelqune:zelqune_dev@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
EVENT_RETRY_DELAYS_MS=5000,30000,120000
# Fees in integer paisa for the first SHIPPING_BASE_WEIGHT_GRAMS; + per started extra kg
SHIPPING_FEE_DHAKA_PAISA=7000
SHIPPING_FEE_SUBURB_PAISA=11000
SHIPPING_FEE_OUTSIDE_PAISA=13000
SHIPPING_BASE_WEIGHT_GRAMS=1000
SHIPPING_EXTRA_PER_KG_PAISA=2000
# Volumetric weight (kg) = L x W x H (cm) / divisor; chargeable = max(actual, volumetric)
SHIPPING_VOLUMETRIC_DIVISOR=5000
SHIPPING_DEFAULT_PACKAGE_WEIGHT_GRAMS=1000
