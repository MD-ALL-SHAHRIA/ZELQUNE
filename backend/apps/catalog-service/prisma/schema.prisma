// catalog-service owns the "catalog" Postgres schema. Never reference another service's tables;
// share data only via RPC or events (libs/contracts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Transactional outbox: written in the same transaction as the business change,
/// published to RabbitMQ by OutboxRelay (libs/common/src/outbox).
model OutboxEvent {
  id            String    @id @db.Uuid
  type          String
  version       Int
  source        String
  payload       Json
  requestId     String?   @map("request_id")
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

/// Idempotent-consumer ledger: one row per (event, handler) already applied.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, handler])
  @@map("processed_events")
}

enum SaleMode {
  IN_STOCK
  MADE_TO_ORDER
  PRE_ORDER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaStatus {
  PENDING
  READY
}

enum ExperimentKey {
  a
  b
}

/// Category tree (parentId). Bilingual names.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  slug      String   @unique
  nameBn    String   @map("name_bn")
  nameEn    String   @map("name_en")
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique
  nameBn           String        @map("name_bn")
  nameEn           String        @map("name_en")
  descriptionBn    String?       @map("description_bn")
  descriptionEn    String?       @map("description_en")
  saleMode         SaleMode      @map("sale_mode")
  leadTimeDays     Int?          @map("lead_time_days")
  status           ProductStatus @default(DRAFT)
  seoTitleBn       String?       @map("seo_title_bn")
  seoTitleEn       String?       @map("seo_title_en")
  seoDescriptionBn String?       @map("seo_description_bn")
  seoDescriptionEn String?       @map("seo_description_en")
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  variants   ProductVariant[]
  media      Media[]
  categories ProductCategory[]
  promotions PromotionProduct[]

  @@index([status, publishedAt])
  @@map("products")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  position   Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  sku                String   @unique
  /// e.g. {"finish":"WALNUT"}
  options            Json     @default("{}")
  weightGrams        Int?     @map("weight_grams")
  widthMm            Int?     @map("width_mm")
  heightMm           Int?     @map("height_mm")
  depthMm            Int?     @map("depth_mm")
  /// Packaged size/weight for shipping (chargeable weight), separate from the product's own size.
  packageLengthMm    Int?     @map("package_length_mm")
  packageWidthMm     Int?     @map("package_width_mm")
  packageHeightMm    Int?     @map("package_height_mm")
  packageWeightGrams Int?     @map("package_weight_grams")
  position           Int      @default(0)
  isActive           Boolean  @default(true) @map("is_active")
  /// What one unit costs to make (materials + labour), for profit and loss. Admin only.
  costPaisa          Int?     @map("cost_paisa")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices      Price[]
  experiments PriceExperiment[]
  media       Media[]

  @@index([productId])
  @@map("product_variants")
}

/// Uploaded via presigned URL (StorageProvider); only READY media is ever shown publicly.
model Media {
  id         String      @id @db.Uuid
  productId  String      @map("product_id") @db.Uuid
  variantId  String?     @map("variant_id") @db.Uuid
  storageKey String      @unique @map("storage_key")
  mimeType   String      @map("mime_type")
  bytes      Int
  altBn      String?     @map("alt_bn")
  altEn      String?     @map("alt_en")
  position   Int         @default(0)
  status     MediaStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@map("media")
}

/// Base price history: the current price has startsAt <= now < endsAt (or no endsAt).
/// Money is integer paisa.
model Price {
  id             String    @id @default(uuid()) @db.Uuid
  variantId      String    @map("variant_id") @db.Uuid
  /// RETAIL for storefront prices; WHOLESALE / per-organization lists arrive in M2 (5ক).
  priceListId    String    @default("RETAIL") @map("price_list_id")
  amountPaisa    Int       @map("amount_paisa")
  compareAtPaisa Int?      @map("compare_at_paisa")
  startsAt       DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, priceListId, startsAt])
  @@map("prices")
}

/// Price A/B test arm for a variant, selected with ?p=a|b.
model PriceExperiment {
  id          String        @id @default(uuid()) @db.Uuid
  variantId   String        @map("variant_id") @db.Uuid
  key         ExperimentKey
  amountPaisa Int           @map("amount_paisa")
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, key])
  @@map("price_experiments")
}

/// Storefront content documents edited by the owner (ADR 0015), one row per key ("home").
/// `data` is validated by homeContentSchema (libs/contracts) on every write.
model SiteContent {
  key       String   @id
  version   Int
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_content")
}

/// Images uploaded for content (hero scenes, collection covers), not tied to a product.
model ContentAsset {
  id         String      @id @db.Uuid
  storageKey String      @unique @map("storage_key")
  mimeType   String      @map("mime_type")
  bytes      Int
  status     MediaStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("content_assets")
}

enum PromotionKind {
  PERCENT
  FIXED
}

/// Flash and seasonal sales: lower the price of the covered products between startsAt and
/// endsAt (no products = every product). Applied in price resolution, so checkout charges it.
model Promotion {
  id        String        @id @default(uuid()) @db.Uuid
  nameEn    String        @map("name_en")
  nameBn    String        @map("name_bn")
  kind      PromotionKind
  /// PERCENT: 1-90. FIXED: paisa off each unit.
  value     Int
  startsAt  DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime      @map("ends_at") @db.Timestamptz(3)
  flash     Boolean       @default(true)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  products PromotionProduct[]

  @@index([active, startsAt, endsAt])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String @map("promotion_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}
