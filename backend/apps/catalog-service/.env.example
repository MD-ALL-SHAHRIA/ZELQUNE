# catalog-service: for running outside Docker (cp .env.example .env). docker-compose sets these itself.
NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3002
TCP_HOST=0.0.0.0
TCP_PORT=4002
DB_SCHEMA=catalog
DATABASE_URL=postgresql://catalog_svc:zelqune_svc_dev@localhost:5432/zelqune?schema=catalog
RABBITMQ_URL=amqp://zelqune:zelqune_dev@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
# Media storage: local (dev fake served at /dev-storage on this service) or r2
STORAGE_DRIVER=local
MEDIA_PUBLIC_BASE_URL=http://localhost:3002/dev-storage
LOCAL_STORAGE_DIR=/tmp/zelqune-media
# >= 32 chars; leave empty to use a random per-process secret (dev only)
LOCAL_STORAGE_SIGNING_SECRET=
UPLOAD_URL_TTL_SECONDS=600
# Required when STORAGE_DRIVER=r2 (Cloudflare R2, S3 API). MEDIA_PUBLIC_BASE_URL = bucket public URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
