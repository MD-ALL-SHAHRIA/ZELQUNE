# order-service: for running outside Docker (cp .env.example .env). docker-compose sets these itself.
NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3004
TCP_HOST=0.0.0.0
TCP_PORT=4004
DB_SCHEMA=orders
DATABASE_URL=postgresql://orders_svc:zelqune_svc_dev@localhost:5432/zelqune?schema=orders
RABBITMQ_URL=amqp://zelqune:zelqune_dev@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
EVENT_RETRY_DELAYS_MS=5000,30000,120000
# Advance for PRE_ORDER / MADE_TO_ORDER: fixed (default ৳300, capped at the total) or percent of subtotal
ADVANCE_MODE=fixed
ADVANCE_FIXED_PAISA=30000
ADVANCE_PERCENT=
# PENDING_PAYMENT orders are cancelled after this many hours (and their stock released)
ORDER_HOLD_HOURS=48
ORDER_SWEEP_INTERVAL_MS=60000
SAGA_RECOVERY_AFTER_SECONDS=60
CART_TTL_DAYS=30
# Services this one calls (saga participants)
RPC_TIMEOUT_MS=5000
CATALOG_SERVICE_HOST=localhost
CATALOG_SERVICE_PORT=4002
INVENTORY_SERVICE_HOST=localhost
INVENTORY_SERVICE_PORT=4003
PAYMENT_SERVICE_HOST=localhost
PAYMENT_SERVICE_PORT=4005
SHIPPING_SERVICE_HOST=localhost
SHIPPING_SERVICE_PORT=4006
