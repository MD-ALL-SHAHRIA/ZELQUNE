# inventory-service: for running outside Docker (cp .env.example .env). docker-compose sets these itself.
NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3003
TCP_HOST=0.0.0.0
TCP_PORT=4003
DB_SCHEMA=inventory
DATABASE_URL=postgresql://inventory_svc:zelqune_svc_dev@localhost:5432/zelqune?schema=inventory
RABBITMQ_URL=amqp://zelqune:zelqune_dev@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
EVENT_RETRY_DELAYS_MS=5000,30000,120000
# Checkout window, then HELD until the order is confirmed or ORDER_HOLD_HOURS pass
RESERVATION_TTL_SECONDS=900
ORDER_HOLD_HOURS=48
RESERVATION_SWEEP_INTERVAL_MS=30000
