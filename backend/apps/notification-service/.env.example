# notification-service: for running outside Docker (cp .env.example .env). docker-compose sets these itself.
NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3007
TCP_HOST=0.0.0.0
TCP_PORT=4007
DB_SCHEMA=notifications
DATABASE_URL=postgresql://notifications_svc:zelqune_svc_dev@localhost:5432/zelqune?schema=notifications
RABBITMQ_URL=amqp://zelqune:zelqune_dev@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
EVENT_RETRY_DELAYS_MS=5000,30000,120000
# console = print SMS to the log (real BD SMS gateway: M3, owner approval)
SMS_DRIVER=console
# Owner's phone for new bulk-order alerts (optional)
OWNER_NOTIFY_PHONE=
STOREFRONT_URL=http://localhost:3100
