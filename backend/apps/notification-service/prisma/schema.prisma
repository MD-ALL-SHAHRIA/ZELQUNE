// notification-service owns the "notifications" Postgres schema. Never reference another service's tables;
// share data only via RPC or events (libs/contracts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Transactional outbox: written in the same transaction as the business change,
/// published to RabbitMQ by OutboxRelay (libs/common/src/outbox).
model OutboxEvent {
  id            String    @id @db.Uuid
  type          String
  version       Int
  source        String
  payload       Json
  requestId     String?   @map("request_id")
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

/// Idempotent-consumer ledger: one row per (event, handler) already applied.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, handler])
  @@map("processed_events")
}

enum NotificationStatus {
  SENT
  FAILED
}

/// Who to notify about an order (from order.placed); the only place phones live in this service.
model OrderContact {
  orderId              String   @id @map("order_id") @db.Uuid
  code                 String
  name                 String
  phone                String
  saleMode             String   @map("sale_mode")
  paymentMethod        String   @map("payment_method")
  totalPaisa           Int      @map("total_paisa")
  advanceRequiredPaisa Int      @map("advance_required_paisa")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("order_contacts")
}

/// Every message sent (or attempted). One per (event, template): redelivery never re-sends.
model NotificationLog {
  id          String             @id @default(uuid()) @db.Uuid
  eventId     String             @map("event_id") @db.Uuid
  template    String
  channel     String             @default("SMS")
  recipient   String
  body        String
  status      NotificationStatus
  provider    String
  providerRef String?            @map("provider_ref")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([eventId, template])
  @@index([recipient])
  @@map("notification_logs")
}

/// Owner-editable settings (ADR 0017): one JSON value per key; env values apply until saved.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by")

  @@map("settings")
}
