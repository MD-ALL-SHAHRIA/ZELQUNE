                  "nullable": true
                },
                "slug": {
                  "type": "string"
                },
                "nameBn": {
                  "type": "string"
                },
                "nameEn": {
                  "type": "string"
                },
                "position": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
