          },
          "phone": {
            "type": "string",
            "example": "+8801712345678"
          },
          "name": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "email": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "STAFF",
              "OWNER"
            ]
          }
        },
        "required": [
